generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ======================================================
// ROLES
// ======================================================

model Roles {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  description      String

  Users            User[]
  role_permissions role_permissions[]

  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
}


// ======================================================
// PERMISOS
// ======================================================

model Permissions {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  description      String

  role_permissions role_permissions[]

  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
}


// ======================================================
// RELACIÓN ROLES - PERMISOS
// ======================================================

model role_permissions {
  id            Int         @id @default(autoincrement())
  role_id       Int
  permission_id Int

  role          Roles       @relation(fields: [role_id], references: [id])
  permission    Permissions @relation(fields: [permission_id], references: [id])

  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  @@unique([role_id, permission_id])
}


// ======================================================
// USUARIOS
// ======================================================

model User {
  clerkid       String   @id
  id            Int      @unique @default(autoincrement())

  email         String   @unique
  fullname      String?

  password_hash String?
  phone         String?  @unique

  is_active     Boolean  @default(true)

  role_id       Int?
  role          Roles?   @relation(fields: [role_id], references: [id])

  services_providers Services_providers[]
  notifications      notifications[]
  audit_logs          audit_logs[]

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}


// ======================================================
// CATEGORÍAS DE SERVICIOS
// ======================================================

model Services_categories {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String

  services    Services[]

  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
}


// ======================================================
// SERVICIOS
// ======================================================

model Services {
  id               Int                 @id @default(autoincrement())

  name             String              @unique
  description      String
  duration_minutes Int
  price            Float
  is_active        Boolean             @default(true)

  category_id      Int
  category         Services_categories @relation(fields: [category_id], references: [id])

  // Un servicio puede tener varios proveedores
  // y un proveedor puede ofrecer varios servicios.
  service_providers Services_providers[]

  reservations      Reservations[]

  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt
}


// ======================================================
// PROVEEDORES DE SERVICIO
// ======================================================

model Services_providers {
  id            Int      @id @default(autoincrement())

  user_id       String
  user          User     @relation(fields: [user_id], references: [clerkid])

  name          String
  description   String
  business_name String

  phone         String   @unique
  address       String

  is_active     Boolean  @default(true)

  // Relación muchos a muchos con Services
  services      Services[]

  availabilities Availabilities[]
  reservations   Reservations[]

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}


// ======================================================
// DISPONIBILIDADES
// ======================================================

model Availabilities {
  id                  Int                @id @default(autoincrement())

  service_provider_id Int

  service_provider    Services_providers @relation(fields: [service_provider_id], references: [id])

  start_time          DateTime
  end_time            DateTime

  is_available        Boolean            @default(true)

  slots               Slots[]

  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
}


// ======================================================
// SLOTS
// ======================================================

model Slots {
  id              Int            @id @default(autoincrement())

  availability_id Int

  availability    Availabilities @relation(fields: [availability_id], references: [id])

  start_time      DateTime
  end_time        DateTime

  status          String         @default("available")

  // Un slot puede tener como máximo una reserva
  reservation     Reservations?

  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
}


// ======================================================
// CLIENTES
// ======================================================

model Clients {
  id           Int    @id @default(autoincrement())

  name         String
  email        String @unique
  phone        String @unique

  reservations Reservations[]

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}


// ======================================================
// RESERVAS
// ======================================================

model Reservations {
  id Int @id @default(autoincrement())


  // ----------------------------------------------------
  // CLIENTE
  // ----------------------------------------------------

  client_id Int

  client    Clients @relation(fields: [client_id], references: [id])


  // ----------------------------------------------------
  // SLOT
  // ----------------------------------------------------

  slot_id Int @unique

  slot    Slots @relation(fields: [slot_id], references: [id])


  // ----------------------------------------------------
  // PROVEEDOR
  // ----------------------------------------------------

  service_provider_id Int

  service_provider    Services_providers @relation(fields: [service_provider_id], references: [id])


  // ----------------------------------------------------
  // SERVICIO
  // ----------------------------------------------------

  service_id Int

  service    Services @relation(fields: [service_id], references: [id])


  // ----------------------------------------------------
  // DATOS DE LA RESERVA
  // ----------------------------------------------------

  status    String  @default("pending")
  notes     String?


  // ----------------------------------------------------
  // FECHAS
  // ----------------------------------------------------

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}


// ======================================================
// NOTIFICACIONES
// ======================================================

model notifications {
  id Int @id @default(autoincrement())


  user_id String

  user    User @relation(fields: [user_id], references: [clerkid])


  type    String
  title   String
  message String

  status  String   @default("unread")

  sent_at DateTime @default(now())


  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}


// ======================================================
// REGISTROS DE AUDITORÍA
// ======================================================

model audit_logs {
  id Int @id @default(autoincrement())


  user_id String

  user    User @relation(fields: [user_id], references: [clerkid])


  action    String
  entity    String
  entity_id Int
  changes   String


  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}


// ======================================================
// CONFIGURACIÓN DEL SISTEMA
// ======================================================

model System_config {
  id          Int    @id @default(autoincrement())

  key         String @unique
  value       String
  description String

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}